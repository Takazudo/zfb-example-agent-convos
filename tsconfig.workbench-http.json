{
  "compilerOptions": {
    "target": "ES2022",
    "module": "AMD",
    "moduleResolution": "Node",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmitOnError": true,
    "rootDir": ".",
    "outFile": "build/workbench-http.js",
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "files": [
    "dev/http-entry.ts"
  ]
}
